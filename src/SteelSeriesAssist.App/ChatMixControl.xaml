<UserControl x:Class="SteelSeriesAssist.App.ChatMixControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MixTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border Background="Transparent" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MixSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent">
                    <Border Height="4" Margin="8,0" CornerRadius="2" VerticalAlignment="Center" Background="#46515E" />
                    <Border Width="2" Height="12" CornerRadius="1" Background="#8591A3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Track x:Name="PART_Track" Margin="8,0">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource MixTrackButton}" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="18" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Border x:Name="Knob" Width="18" Height="20" CornerRadius="4" Background="#D0D9F6">
                                <Border Width="2" Height="10" Background="#6675FF" CornerRadius="1" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Background" Value="White" /></Trigger>
                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Background" Value="#AAB4FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource MixTrackButton}" /></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Padding="12" Margin="0,0,0,8" CornerRadius="7" Background="#232B32">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="均衡" Click="Reset_Click"
                        ToolTip="恢复游戏与聊天均衡" IsEnabled="False" Padding="5,2"
                        Foreground="#AAB4FF" Background="Transparent" BorderThickness="0" Cursor="Hand" />
                <TextBlock Text="聊天混音" Foreground="#D0D9F6" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="游戏" Foreground="#02DDBC" VerticalAlignment="Center" />
                <Slider x:Name="BalanceSlider" Grid.Column="1" Margin="12,0" Minimum="-100" Maximum="100"
                        Style="{StaticResource MixSlider}"
                        Value="0" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True" IsEnabled="False" Foreground="#8996FF"
                        AutomationProperties.Name="游戏与聊天混音，向左偏游戏，向右偏聊天"
                        ValueChanged="Balance_ValueChanged" PreviewMouseLeftButtonUp="Balance_MouseUp"
                        LostMouseCapture="Balance_LostMouseCapture" PreviewKeyUp="Balance_KeyUp" />
                <TextBlock Grid.Column="2" Text="聊天" Foreground="#47B6F5" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="HintText" Text="等待连接 Sonar…" Margin="0,6,0,0"
                       Foreground="#868FA2" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
